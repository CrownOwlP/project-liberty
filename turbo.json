{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    ".env",
    ".env.development",
    ".env.development.local",
    ".env.local",
    ".env.production",
    ".env.production.local",
    ".env.test",
    ".env.test.local"
  ],
  "globalEnv": [
    "NODE_ENV",
    "CONTENT_RIGHTS_ENFORCEMENT",
    "LIBERTY_FC_SEED",
    "LIBERTY_FIXTURE_MEDIA_ORIGIN",
    "LIBERTY_BUILD_TARGET",
    "LIBERTY_PLAYBACK_BACKEND_ORIGIN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "!.next/cache/**", "!dist/desktop/**"]
    },
    "build:desktop": {
      "dependsOn": ["^build"],
      "outputs": ["dist/desktop/**", "!dist/desktop/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "@liberty/web#typecheck": {
      "dependsOn": ["^typecheck", "build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
