{
  "name": "@liberty/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/with-root-env.mjs next dev",
    "dev:desktop": "node -e \"const{spawnSync}=require('node:child_process'),fs=require('node:fs'),f='next-env.d.ts';const keep=fs.existsSync(f)?fs.readFileSync(f):null,a=process.argv.slice(1);const r=spawnSync(a[0],a.slice(1),{stdio:'inherit',shell:process.platform==='win32',env:{...process.env,LIBERTY_BUILD_TARGET:'desktop'}});if(keep&&fs.existsSync(f)&&!fs.readFileSync(f).equals(keep))fs.writeFileSync(f,keep);process.exit(r.status??1)\" node ../../scripts/with-root-env.mjs next dev",
    "build": "next build",
    "build:desktop": "node -e \"const{spawnSync}=require('node:child_process'),fs=require('node:fs'),f='next-env.d.ts';const keep=fs.existsSync(f)?fs.readFileSync(f):null,a=process.argv.slice(1);const r=spawnSync(a[0],a.slice(1),{stdio:'inherit',shell:process.platform==='win32',env:{...process.env,LIBERTY_BUILD_TARGET:'desktop'}});if(keep&&fs.existsSync(f)&&!fs.readFileSync(f).equals(keep))fs.writeFileSync(f,keep);process.exit(r.status??1)\" next build",
    "start": "node ../../scripts/with-root-env.mjs next start",
    "start:desktop": "node -e \"const{spawnSync}=require('node:child_process'),fs=require('node:fs'),f='next-env.d.ts';const keep=fs.existsSync(f)?fs.readFileSync(f):null,a=process.argv.slice(1);const r=spawnSync(a[0],a.slice(1),{stdio:'inherit',shell:process.platform==='win32',env:{...process.env,LIBERTY_BUILD_TARGET:'desktop'}});if(keep&&fs.existsSync(f)&&!fs.readFileSync(f).equals(keep))fs.writeFileSync(f,keep);process.exit(r.status??1)\" node ../../scripts/with-root-env.mjs next start",
    "lint": "eslint . --ignore-pattern \"dist/**\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@liberty/auth": "0.1.0",
    "@liberty/catalog-ingestion": "0.1.0",
    "@liberty/contracts": "0.1.0",
    "@liberty/media-engine": "0.1.0",
    "@liberty/media-inspection": "0.1.0",
    "@liberty/observability": "0.1.0",
    "@liberty/persistence": "0.1.0",
    "@liberty/provider-sdk": "0.1.0",
    "custom-media-element": "^1.4.6",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shaka-player": "~5.2.6",
    "xstate": "^5.32.5",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "fast-check": "^4.9.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
