      "kind": "local-lead",
      "capabilities": ["Coordination", "Integration", "Architecture", "Review"],
      "maxParallel": 2,
      "writeMode": "worktree",
      "notes": "Claude Code Desktop lead. Decomposes work, coordinates subagents, integrates and verifies."
    },
    {
