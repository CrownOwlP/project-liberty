{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Liberty Experiment 1a",
  "version": "0.0.0",
  "identifier": "app.projectliberty.exp1a",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Liberty Experiment 1a — compositing proof",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "transparent": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
