{
  "name": "@liberty/media-inspection",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./egress": {
      "types": "./src/egress.ts",
      "default": "./src/egress.ts"
    },
    "./http": {
      "types": "./src/http.ts",
      "default": "./src/http.ts"
    },
    "./pin": {
      "types": "./src/pin.ts",
      "default": "./src/pin.ts"
    },
    "./node/*": {
      "types": "./src/node/*.ts",
      "default": "./src/node/*.ts"
    },
    "./package.json": "./package.json"
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:transport": "vitest run src/node"
  },
  "dependencies": {
    "@liberty/contracts": "0.1.0",
    "@liberty/net-policy": "0.1.0",
    "@xmldom/xmldom": "0.9.12",
    "m3u8-parser": "7.2.0"
  },
  "devDependencies": {
    "fast-check": "^4.9.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
