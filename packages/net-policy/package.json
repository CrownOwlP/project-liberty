{
  "name": "@liberty/net-policy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./classify": {
      "types": "./src/classify.ts",
      "default": "./src/classify.ts"
    },
    "./host": {
      "types": "./src/host.ts",
      "default": "./src/host.ts"
    },
    "./testing/*": {
      "types": "./src/testing/*.ts",
      "default": "./src/testing/*.ts"
    },
    "./package.json": "./package.json"
  },
  "types": "./src/index.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "fast-check": "^4.9.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
