{
  "name": "@liberty/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./domains/*": {
      "types": "./src/domains/*.ts",
      "default": "./src/domains/*.ts"
    },
    "./shared/*": {
      "types": "./src/shared/*.ts",
      "default": "./src/shared/*.ts"
    },
    "./package.json": "./package.json"
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
