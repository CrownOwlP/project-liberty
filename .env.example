# =============================================================================
# Project Liberty environment contract
# =============================================================================
#
# This file is the SINGLE SOURCE OF TRUTH for which environment variables exist,
# what each one is for, and which ones are required. `scripts/validate-env.mjs`
# parses it: the `@` lines below are machine-read annotations, not decoration.
# Declaring a variable here is how it enters the contract, and a variable that
# is read by code but absent from this file will never be validated by anything.
#
# NEVER put a real secret in this file. It is committed, and a credential that
# reaches version control has to be rotated even if nobody ever used it. Values
# here are placeholders and throwaway local defaults only. Anything annotated
# `@secret` must be left blank or as `replace-me`, and validate-env.mjs fails
# the contract itself -- not just your environment -- when it is not.
#
# Copy to `.env.local` (git-ignored) and put real values there:
#
#   cp .env.example .env.local
#
# Annotations:
#   @required          validate-env fails when the variable is unset or empty
#   @optional          absence is fine; the format is still checked when present
#   @default <value>   absence is fine AND well-defined: this is the value the
#                      project behaves as if it had. Reported as a warning when
#                      unset, never as a failure -- a fresh clone with no
#                      .env.local passes. Setting it to an INVALID value still
#                      fails, everywhere: that is a wrong answer, not an absence.
#   @secret            a credential. Must stay a placeholder in this file, and a
#                      value still equal to the placeholder counts as "not
#                      configured" rather than as a satisfied requirement.
#   @cache-key         turbo.json lists this variable in `globalEnv`, so its
#                      value is hashed into the build cache key and an unset one
#                      hashes as absent. Requires @default, and turns the
#                      unset-warning into a failure under `--scope ci`, where a
#                      cache entry is shared between machines.
#   @format <kind>     nonempty | url | postgres-url | redis-url | integer |
#                      hex40 | enum:a,b,c
#   @scope app|ci      `app` (the default) means the variable applies anywhere
#                      the app or the build runs, local machines included. `ci`
#                      means automation only, so a local run does not demand it.
#
# Annotations are recognised only in the forms above, on a line of their own. A
# description that happens to mention an @-name in passing stays prose.
#
# Every variable must carry a description and exactly one answer to "what if it
# is unset": @required, @optional, or @default. An entry that does not say what
# the variable is for is not documentation, and validate-env rejects it.

# =============================================================================
# Application runtime
# =============================================================================

# Node/Next build mode. Tooling normally sets this, so it is optional here; it
# is declared because turbo.json lists it in `globalEnv`, which makes its value
# part of the build cache key.
# @optional
# @format enum:development,test,production
NODE_ENV=development

# Product name used in UI chrome, so the string lives in one place instead of
# being retyped per surface.
# @optional
# @format nonempty
NEXT_PUBLIC_APP_NAME=Project Liberty

# Absolute origin this deployment is reachable at. Anything that builds an
# absolute link -- share URLs, OAuth callbacks, sitemaps -- needs the real
# origin rather than one inferred from an incoming request host, which is
# attacker-controlled behind a proxy.
# @optional
# @format url
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Rights-enforcement mode. `strict` is the only accepted value: relaxing it is a
# content-rights policy change, and docs/CONTENT_RIGHTS.md is a non-negotiable
# boundary, so such a change happens there first or not at all.
#
# Defaulted rather than required, and marked @cache-key, because both facts are
# true at once. turbo.json hashes this variable into the build cache key, so an
# unset value hashes as absent and one cache entry could serve builds that meant
# two different enforcement modes -- that risk is real and is why the warning
# names it. But no code reads this variable yet, `strict` is the only value it
# may hold, and requiring it would mean a fresh clone failed its own validation
# on day one. A check that fails a correct checkout gets ignored, and an ignored
# check catches nothing at all. So: unset is a warning locally, a failure under
# `--scope ci`, and anything other than `strict` is a failure everywhere.
# @default strict
# @cache-key
# @format enum:strict
CONTENT_RIGHTS_ENFORCEMENT=strict

# Minimum log level. The accepted set mirrors `LogLevel` in
# @liberty/observability; a value outside it is silently ignored by the logger
# rather than rejected, which is exactly the kind of typo that only surfaces as
# "why are there no debug logs" three hours into an incident.
# @optional
# @format enum:debug,info,warn,error
LOG_LEVEL=info

# Seed for the fast-check property suite. Pinned rather than random, and that is
# the point: an unpinned property suite fails on roughly one run in forty with a
# counterexample nobody can reproduce, and a test that cannot be reproduced gets
# retried until it passes -- which converts a real defect into noise. Override it
# to widen the search, typically in a nightly job, then pin any counterexample it
# finds by copying the seed fast-check prints alongside the failure.
#
# Marked as a cache key because turbo.json lists it in `globalEnv`: the seed
# genuinely changes what the test task computes, so two runs under different
# seeds must not share a cache entry. It carries a default for the same reason
# CONTENT_RIGHTS_ENFORCEMENT does -- a fresh clone must pass its own validation,
# and requiring a seed nobody needs to choose would teach people to ignore the
# validator.
#
# (Written as prose rather than starting a line with the annotation keyword,
# because a comment line whose first token is a known annotation IS one, and
# `@cache-key` takes no value. Explaining an annotation and declaring it are the
# same syntax to the parser.)
# @default 20250819
# @cache-key
# @format integer
LIBERTY_FC_SEED=20250819

# Origin the watch route's development fixture streams are served from, read by
# apps/web/src/app/watch/watch-session.ts. The default host is reserved by
# RFC 2606 and resolves nowhere, so out of the box every fixture candidate fails
# and the page shows the whole failover trail -- a more useful default than a
# player that silently does nothing, and one that can never reach a real host by
# accident. Point it at a local DASH/HLS rig to watch something: a loopback
# origin is carved out by the transport check in playback-source.ts.
#
# Marked as a cache key because turbo.json lists it in `globalEnv`, and it earns
# that listing: the value is baked into the candidate URIs a build produces, so
# an unset one hashes as absent and a cached build made against a local rig would
# be served to a run that meant the dead default. It carries a default rather
# than being merely optional for the same reason CONTENT_RIGHTS_ENFORCEMENT does
# -- the fallback is real, committed and identical everywhere, so a fresh clone
# must pass its own validation instead of being told to set something nobody
# needs to choose.
#
# (Written as prose rather than starting a line with the annotation keyword,
# because a comment line whose first token is a known annotation IS one.)
# @default https://fixtures.invalid
# @cache-key
# @format url
LIBERTY_FIXTURE_MEDIA_ORIGIN=https://fixtures.invalid

# =============================================================================
# Local infrastructure (infra/docker-compose.yml)
#
# Both services are optional by design: nothing the gates run connects to
# either, so neither is required to run the web app, the tests, or `npm run
# check`. That is a narrower claim than it used to be -- this banner said "no
# ORM is pinned yet" long after packages/persistence pinned drizzle and
# drizzle.config.ts started reading DATABASE_URL, which is how a stale reason
# outlives the fact it was a reason for. DATABASE_URL is still @optional, and
# deliberately: no gate runs a migration, so an unset value breaks nothing until
# you invoke db:migrate yourself, and drizzle-kit's own failure on an empty
# connection URL lands closer to the mistake than a validator could. Marking it
# as required instead would fail a correct clone that simply has no database.
#
# (Phrased that way on purpose: a comment line whose FIRST token is an
# annotation keyword is read as one, so the word is kept off the start of a line
# -- the same care the LIBERTY_FIXTURE_MEDIA_ORIGIN block above takes.)
#
# They are format-checked whenever they are set, because a URL pointing at the
# wrong port fails much later and much less obviously than a URL that is simply
# absent.
#
# Reachability is not checked by default. Run `node scripts/validate-env.mjs
# --services` when you actually expect the stack to be up.
# =============================================================================

# PostgreSQL connection string. The credentials below are the throwaway ones
# hard-coded in infra/docker-compose.yml, which is why they can sit in a
# committed file. A real deployment's DATABASE_URL is a credential: it belongs
# in .env.local or a secret store, never here.
#
# Read by packages/persistence/drizzle.config.ts, which supplies no fallback --
# drizzle-kit fails on an empty connection URL rather than inventing a database.
# Its db:generate / db:migrate / db:check scripts reach this file through
# scripts/with-root-env.mjs, so the value below is the one a migration will use.
# That cuts both ways: if the DATABASE_URL in your .env.local names a real
# deployment, `npm run db:migrate -w @liberty/persistence` will migrate it. The
# loader prints which file supplied the name before drizzle-kit starts, and
# drizzle.config.ts sets verbose; read both before answering the prompt.
# @optional
# @format postgres-url
DATABASE_URL=postgresql://liberty:liberty@localhost:5432/liberty

# Redis connection string for ephemeral cache, rate limits, and provider health
# snapshots. Same rule as above: the local default is throwaway, a real one is a
# credential.
# @optional
# @format redis-url
REDIS_URL=redis://localhost:6379

# =============================================================================
# Automation only (@scope ci)
#
# These are supplied by GitHub Actions secrets and workflow env, not by
# .env.local. They are listed so the contract is complete -- a variable the
# review worker reads but nothing documents is how an outage becomes a
# scavenger hunt -- and they are left blank so a local `cp .env.example
# .env.local` cannot put a stale token on a developer machine.
# =============================================================================

# OpenAI API key used by scripts/cloud/gpt-review-worker.mjs.
# @optional
# @secret
# @scope ci
OPENAI_API_KEY=

# GitHub token used by scripts/cloud/git-auth.mjs to push control-plane state.
# @optional
# @secret
# @scope ci
GH_TOKEN=

# Review model override for the GPT review worker. Defaults in code when unset.
# @optional
# @scope ci
# @format nonempty
OPENAI_REVIEW_MODEL=

# Reasoning effort for the review model. Defaults in code when unset.
# @optional
# @scope ci
# @format nonempty
OPENAI_REVIEW_EFFORT=

# Maximum patch size, in bytes, the review worker will send to the model.
# @optional
# @scope ci
# @format integer
REVIEW_MAX_PATCH_BYTES=

# Directory holding the durable agent-bus journal. Unset means the journal is
# in-repo and non-durable across runners; see coordination/agent-bus/README.md.
# @optional
# @scope ci
# @format nonempty
LIBERTY_JOURNAL_DIR=

# Commit sha override for harnesses that have no git checkout. Never set this on
# a real runner: it makes the control plane record a sha it did not verify.
# @optional
# @scope ci
# @format hex40
LIBERTY_COMMIT_SHA=

# CI conclusion reported into the mission-control status snapshot.
# @optional
# @scope ci
# @format nonempty
LIBERTY_CI_CONCLUSION=

# Which build target the web application is compiled for. The desktop target
# routes playback through the authenticated backend instead of resolving on
# device, so this is a trust-boundary selector, not a cosmetic flag -- see
# docs/DESKTOP_PLAYBACK.md section 8. Unset means the web target.
# @optional
# @scope app
# @format nonempty
LIBERTY_BUILD_TARGET=

# Origin the desktop build forwards playback-session requests to. Required for
# the desktop target and meaningless for the web one, which has no backend to
# forward to because it IS the backend.
# @optional
# @scope app
# @format nonempty
LIBERTY_PLAYBACK_BACKEND_ORIGIN=

# =============================================================================
# Catalog metadata source (@scope app)
#
# WHAT THESE DO. Set together, they are how an operator tells a hosted
# deployment which licensed metadata source to read, how to identify itself to
# it, what slice of it to serve, and how often to go back. Unset, the
# deployment has no catalog metadata source and says so by name --
# `no_metadata_source_configured` -- rather than quietly serving fixtures.
# docs/CATALOG_SOURCE.md is the long form of every line below.
#
# LIBERTY_CATALOG_SOURCE_ID IS THE SIGNAL, AND THE ONLY ONE. With it unset,
# apps/web/src/lib/server-bootstrap.ts registers nothing and every variable
# below is ignored. With it set, EVERY OTHER VARIABLE IN THIS SECTION BECOMES
# REQUIRED: a deployment that states some of them is refused at startup with
# all the missing names listed at once, and registers nothing. There is no
# value of any other variable that can turn a source on.
#
# THERE IS NO CREDENTIAL HERE AND THERE IS NO FIELD FOR ONE. The initial
# licensed source needs none. A keyed source is a Credentials escalation that
# has not been taken, and server-bootstrap.test.ts asserts mechanically that
# no name this application reads for the catalog is credential-shaped.
#
# THE VALUES ARE LEFT BLANK, like every other entry in this file. The accepted
# vocabularies are described in the comments rather than pinned with an
# @format enum, deliberately: they are @liberty/catalog-ingestion's schemas,
# the composition root checks against those schemas, and a copy of the list
# here would be a second authority that goes stale the day the package gains a
# value.
# =============================================================================

# Which licensed source to read. `wikidata` is the only name the package's
# frozen licensed-source list carries today. A name nobody licensed is handed
# to the package and refused there, by name, rather than dropped here.
# @optional
# @scope app
# @format nonempty
LIBERTY_CATALOG_SOURCE_ID=

# How this deployment identifies itself to the source, with contact
# information -- e.g. `Liberty/0.1 (https://example.org; ops@example.org)`.
# Wikimedia's User-Agent policy makes this a condition of access, not a
# courtesy: a bad one is an IP block that arrives without notice and applies to
# the whole operator. Nothing defaults it, because a default would attach this
# project's opinion to somebody else's contact reputation.
# @optional
# @scope app
# @format nonempty
LIBERTY_CATALOG_USER_AGENT=

# The class whose instances are enumerated, as an item id -- e.g. Q11424
# (film). One selection reads one class; an operator who wants films and series
# runs two deployments or waits for multi-selection.
# @optional
# @scope app
# @format nonempty
LIBERTY_CATALOG_CLASS_QID=

# What kind of work the class holds: movie, series or episode. DECLARED, never
# derived from the class, because the kind decides which quantity is carried --
# a duration on a series is the length of one episode, and publishing it as the
# series runtime would be a wrong fact nobody would ever report.
# @optional
# @scope app
# @format nonempty
LIBERTY_CATALOG_WORK_KIND=

# Comma-separated locales, most preferred first, at least one -- e.g. `en,fr`.
# Requested from the source AND served to readers.
# @optional
# @scope app
# @format nonempty
LIBERTY_CATALOG_LOCALES=

# The territory availability is evaluated for: an ISO 3166-1 alpha-2 code, or
# WW for worldwide.
# @optional
# @scope app
# @format nonempty
LIBERTY_CATALOG_TERRITORY=

# How a source that names no distribution territory is to be read: `refuse` or
# `treat_as_worldwide`. NEITHER SYNTHESISES A WINDOW. `refuse` withholds the
# work and says why; `treat_as_worldwide` is an operator assertion about their
# own licensing position, recorded as theirs.
# @optional
# @scope app
# @format nonempty
LIBERTY_CATALOG_UNSTATED_AVAILABILITY=

# How many pages one ingestion pass reads. A BOUND, not a tuning knob: a source
# that returned a cursor pointing at itself would otherwise be read into this
# process until it died. No pass resumes a cursor yet, so this is also the size
# of the catalog a reader sees.
# @optional
# @scope app
# @format integer
LIBERTY_CATALOG_MAX_PAGES=

# Milliseconds below which a stored answer is still current -- AND the interval
# at which a refresh pass becomes due. ONE NUMBER FOR BOTH, deliberately: an
# interval and a freshness bound that can be configured out of step fail
# silently and totally, either serving answers that are stale by the
# deployment's own policy or hammering a source for answers that are still
# fresh. The package derives the cadence from this rather than taking a second
# number.
#
# THIS IS WHAT STOPS A PASS PER READ. With it and the two below set, a read
# inside the window is served from stored state and nothing leaves the process.
# @optional
# @scope app
# @format integer
LIBERTY_CATALOG_FRESH_FOR_MS=

# Milliseconds at or beyond which a stored answer is too old to present as
# current. Must be at least LIBERTY_CATALOG_FRESH_FOR_MS; between the two, an
# answer is served WITH its age attached rather than withheld, because an
# hour-old rail beats an error page provided the reader is told. Setting them
# equal collapses this to a single TTL, which is a legitimate policy.
# @optional
# @scope app
# @format integer
LIBERTY_CATALOG_STALE_AFTER_MS=

# The cap, in milliseconds, on exponential backoff after consecutive failed
# passes. Required rather than optional: an uncapped exponential reaches next
# Tuesday after a morning of failures, so a source that came back at noon is
# not asked again that day.
# @optional
# @scope app
# @format integer
LIBERTY_CATALOG_MAX_BACKOFF_MS=
