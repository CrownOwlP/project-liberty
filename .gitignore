node_modules/
.next/
dist/
build/
coverage/
.turbo/

# Dotenv files are ignored by pattern, with the committed contract named back in
# by exception. Enumerating the ones Next.js reads today would mean the next mode
# file somebody adds is tracked by default and noticed only once it is already in
# the history. The exception has to come after the pattern: git applies the last
# rule that matches.
.env*
!.env.example

# Credential-bearing exports that have no business in version control.
# A Stremio addon-cloner export was dropped into the repo root once and carried
# an account password in plaintext. Ignored by pattern rather than by exact
# name, because the next one will have a different filename.
*export*.json
*credentials*.json
*secrets*.json
*.pem
*.key
*.log
.DS_Store
.vercel/
.claude/settings.local.json
*.tsbuildinfo

# Generated for the cloud worker's model step to read with Read, because it has
# no command execution. Regenerated every run; never an implementation artifact.
.liberty-task-briefing.md
