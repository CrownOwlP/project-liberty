node_modules/
.next/
dist/
build/
coverage/
.turbo/

# GENERATED BY NEXT ON EVERY BUILD AND EVERY DEV SERVER (PW-0104).
#
# `apps/web/next-env.d.ts` names whichever `distDir` last built:
# `./.next/types/routes.d.ts` for the web target, `./dist/desktop/dev/...` for
# a desktop dev server. It used to be tracked, and the three `*:desktop`
# scripts snapshotted and restored it around the child -- which worked only on
# a normal exit. Playwright signal-kills `next dev`, so in round 81 the rewrite
# survived and was committed pointing at a directory a fresh clone does not
# have.
#
# Untracking it is the fix that is correct WHEN NO CLEANUP RUNS AT ALL: a file
# git does not track cannot be left dirty by any termination, because there is
# no committed state for it to differ from. `create-next-app` ships the same
# line in its own .gitignore. Measured: `tsc --noEmit -p apps/web/tsconfig.json`
# exits 0 with this file and `.next/` both absent, which is the fresh-clone
# condition; the first `next dev` or `next build` writes it back.
apps/web/next-env.d.ts

# Dotenv files are ignored by pattern, with the committed contract named back in
# by exception. Enumerating the ones Next.js reads today would mean the next mode
# file somebody adds is tracked by default and noticed only once it is already in
# the history. The exception has to come after the pattern: git applies the last
# rule that matches.
.env*
!.env.example

# Credential-bearing exports that have no business in version control.
# A Stremio addon-cloner export was dropped into the repo root once and carried
# an account password in plaintext. Ignored by pattern rather than by exact
# name, because the next one will have a different filename.
*export*.json
*credentials*.json
*secrets*.json
*.pem
*.key
*.log
.DS_Store
.vercel/
.claude/settings.local.json
*.tsbuildinfo

# Generated for the cloud worker's model step to read with Read, because it has
# no command execution. Regenerated every run; never an implementation artifact.
.liberty-task-briefing.md

# NOT ignored, deliberately: apps/web/AGENTS.md and apps/web/CLAUDE.md.
# `next dev` generates both (node_modules/next/dist/server/lib/generate-agent-files.js)
# and agents read them as instruction. Ignoring them would hide a file that
# steers agents behind a rule nobody diffs, and deleting one only makes the
# generator write its block into the other. They are tracked, and pinned by
# content hash in INSTRUCTION_FILE_ALLOWLIST in scripts/validate-repo.mjs, so a
# change to either fails `npm run repo:validate` until someone reads it. Do not
# add an AGENTS.md/CLAUDE.md pattern here to silence that check.
